c.&quot;ProjectId&quot; AS &quot;ProjectId&quot;,&#xd;
p.&quot;ProjectName&quot; AS &quot;ProjectName&quot;,&#xd;
pr.&quot;PromptName&quot; AS &quot;PromptName&quot;,&#xd;
